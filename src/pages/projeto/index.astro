---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
import { fallbackProjects } from "../../data/fallback";
import { imageUrl, sanityDataset, sanityProjectId } from "../../lib/sanity";

const allProjects = fallbackProjects;
const fallback = allProjects[0];
const cover = imageUrl(fallback.coverImage);
const cmsConfig = { projectId: sanityProjectId, dataset: sanityDataset };
---
<BaseLayout title={`${fallback.title} — Eric Freitas`} description={fallback.summary}>
  <Header active="projetos" />
  <main id="conteudo" data-project-page>
    <header class="case-hero shell">
      <a class="back-link" href="/projetos/">← Todos os projetos</a>
      <div class="case-heading">
        <div>
          <p class="overline" data-project="eyebrow">{fallback.eyebrow}</p>
          <h1 data-project="title">{fallback.title}</h1>
        </div>
        <div class="case-summary">
          <p data-project="summary">{fallback.summary}</p>
          <dl>
            <div><dt>Status</dt><dd data-project="status">{fallback.status}</dd></div>
            <div><dt>Ano</dt><dd data-project="year">{fallback.year}</dd></div>
          </dl>
        </div>
      </div>
    </header>

    <section class="case-media shell" data-project-cover>
      {cover ? <img src={cover} alt={fallback.coverImage?.alt || `Captura de tela do projeto ${fallback.title}`} /> : <ProjectVisual label={fallback.title} />}
    </section>

    <section class="case-content shell">
      <aside class="case-index" aria-label="Seções do projeto">
        <a href="#contexto">Contexto</a><a href="#problema">Problema</a><a href="#solucao">Solução</a><a href="#atuacao">Minha atuação</a>
      </aside>
      <div class="case-sections">
        <section id="contexto"><p class="overline">01 · Contexto</p><h2>De onde o projeto parte.</h2><p data-project="context">{fallback.context}</p></section>
        <section id="problema"><p class="overline">02 · Problema</p><h2>O que precisava ser resolvido.</h2><p data-project="problem">{fallback.problem}</p></section>
        <section id="solucao"><p class="overline">03 · Solução</p><h2>Como foi construído.</h2><p data-project="solution">{fallback.solution}</p><ul class="highlight-list" data-project-list="highlights">{fallback.highlights.map((item) => <li>{item}</li>)}</ul></section>
        <section id="atuacao" hidden={!fallback.role && !(fallback.decisions?.length)}><p class="overline">04 · Minha atuação</p><h2>O que decidi, revisei e testei.</h2><p data-project="role">{fallback.role}</p><ul class="highlight-list" data-project-list="decisions">{(fallback.decisions || []).map((item) => <li>{item}</li>)}</ul></section>
        <section id="stack"><p class="overline">05 · Stack e código</p><h2>Tecnologias e repositório.</h2><div class="tag-row" data-project-list="technologies">{fallback.technologies.map((item) => <span>{item}</span>)}</div><p><a class="text-link" data-project-repo href={fallback.repoUrl} hidden={!fallback.repoUrl} target="_blank" rel="noreferrer">Ver o código de {fallback.title} no GitHub <span aria-hidden="true">→</span></a></p></section>
        <section class="gallery-section" data-project-gallery hidden><p class="overline">Galeria</p><div class="gallery-grid"></div></section>
      </div>
    </section>
  </main>
  <Footer />
  <script define:vars={{ cmsConfig, allProjects }}>
    const config = cmsConfig;
    const slug = new URLSearchParams(window.location.search).get("slug") || "macisland";
    const alt = (p, text) => text || `Captura de tela do projeto ${p.title}`;
    function render(p) {
      document.title = `${p.title} — Eric Freitas`;
      const vl = document.querySelector("[data-project-cover] .visual-bar small");
      if (vl) vl.textContent = p.title;
      for (const key of ["title","eyebrow","summary","status","year","context","problem","solution","role"]) {
        const node = document.querySelector(`[data-project="${key}"]`);
        if (node && p[key] != null) node.textContent = String(p[key]);
      }
      for (const key of ["highlights","technologies","decisions"]) {
        const node = document.querySelector(`[data-project-list="${key}"]`);
        if (!node) continue;
        node.innerHTML = "";
        (Array.isArray(p[key]) ? p[key] : []).forEach((value) => {
          const el = document.createElement(key === "technologies" ? "span" : "li");
          el.textContent = value;
          node.appendChild(el);
        });
      }
      const atuacao = document.getElementById("atuacao");
      if (atuacao) atuacao.hidden = !p.role && !(p.decisions && p.decisions.length);
      const repo = document.querySelector("[data-project-repo]");
      if (repo) {
        repo.hidden = !p.repoUrl;
        if (p.repoUrl) { repo.href = p.repoUrl; repo.firstChild.textContent = `Ver o código de ${p.title} no GitHub `; }
      }
      if (p.coverImage?.asset?.url) {
        const img = document.createElement("img");
        img.src = `${p.coverImage.asset.url}?auto=format&w=1800`;
        img.alt = alt(p, p.coverImage.alt);
        document.querySelector("[data-project-cover]").replaceChildren(img);
      }
      const section = document.querySelector("[data-project-gallery]");
      const grid = section?.querySelector(".gallery-grid");
      if (section && grid && Array.isArray(p.gallery) && p.gallery.length) {
        section.hidden = false;
        grid.replaceChildren(...p.gallery.map((g) => {
          const fig = document.createElement("figure");
          const img = document.createElement("img");
          img.loading = "lazy"; img.src = `${g.asset?.url}?auto=format&w=1400`; img.alt = alt(p, g.alt);
          fig.appendChild(img);
          if (g.caption) { const cap = document.createElement("figcaption"); cap.textContent = g.caption; fig.appendChild(cap); }
          return fig;
        }));
      }
    }
    const local = allProjects.find((p) => p.slug === slug);
    if (local) render(local);
    if (config.projectId) {
      const query = encodeURIComponent(`*[_type == "project" && slug.current == $slug][0]{title,"slug":slug.current,eyebrow,summary,year,status,context,problem,solution,role,decisions,repoUrl,highlights,technologies,coverImage{asset->{url},alt},gallery[]{asset->{url},alt,caption}}`);
      const url = `https://${config.projectId}.api.sanity.io/v2026-09-01/data/query/${config.dataset}?query=${query}&$slug=${encodeURIComponent(JSON.stringify(slug))}`;
      fetch(url).then((r) => r.ok ? r.json() : null).then((payload) => { if (payload?.result) render(payload.result); }).catch(() => {});
    }
  </script>
</BaseLayout>
