---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LiveContent from "../components/LiveContent.astro";
import { getProjects, getSiteSettings } from "../lib/content";

const settings = await getSiteSettings();
const projects = await getProjects();
const featured = projects.find((project) => project.featured) || projects[0];
const others = projects.filter((project) => project._id !== featured?._id).slice(0, 3);
---
<BaseLayout>
  <Header active="inicio" />
  <main id="conteudo">
    <section class="hero shell">
      <div class="hero-copy">
        <p class="overline" data-cms="role">{settings.role}</p>
        <h1 data-cms="heroTitle">{settings.heroTitle}</h1>
        <p class="hero-lead" data-cms="heroBody">{settings.heroBody}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projetos">Ver projetos</a>
          <a class="button button-quiet" href="/sobre/">Sobre mim <span aria-hidden="true">→</span></a>
        </div>
        <dl class="hero-facts">
          <div><dt>Base</dt><dd data-cms="location">{settings.location}</dd></div>
          <div><dt>Foco</dt><dd>GovTech · produtos digitais</dd></div>
          <div><dt>Abordagem</dt><dd>Contexto antes da tecnologia</dd></div>
        </dl>
      </div>
      <div class="hero-system" aria-label="Representação de um fluxo de serviço público digital">
        <div class="system-label">SERVIÇO PÚBLICO DIGITAL</div>
        <div class="system-flow">
          <div class="flow-node"><small>01</small><strong>Entender</strong><span>processo real</span></div>
          <span class="flow-line"></span>
          <div class="flow-node"><small>02</small><strong>Modelar</strong><span>regras e dados</span></div>
          <span class="flow-line"></span>
          <div class="flow-node"><small>03</small><strong>Construir</strong><span>produto utilizável</span></div>
        </div>
        <div class="system-caption">Software como infraestrutura de trabalho — não como camada decorativa.</div>
      </div>
    </section>

    <section class="section section-rule shell" id="projetos">
      <div class="section-intro split-heading">
        <div>
          <p class="overline">Projetos selecionados</p>
          <h2>Casos construídos a partir de necessidades concretas.</h2>
        </div>
        <p>Código público não é o critério. O que importa aqui é o problema, a decisão de produto e a solução construída.</p>
      </div>
      <div data-live-projects data-live-limit="4">
        {featured && <ProjectCard project={featured} featured />}
        {others.length > 0 && (
          <div class="project-list">
            {others.map((project) => <ProjectCard project={project} />)}
          </div>
        )}
      </div>
      <div class="section-action"><a class="text-link" href="/projetos/">Ver todos os projetos <span aria-hidden="true">→</span></a></div>
    </section>

    <section class="section civic-section">
      <div class="shell civic-grid">
        <div class="section-intro">
          <p class="overline">GovTech em prática</p>
          <h2>O diferencial está em compreender o serviço antes de escrever o código.</h2>
        </div>
        <div class="principles">
          <article><span>01</span><h3>Domínio</h3><p>Processos públicos têm regras, exceções, documentos, responsabilidades e consequências. O produto precisa nascer desse contexto.</p></article>
          <article><span>02</span><h3>Produto</h3><p>Digitalizar não é transportar uma planilha para uma tela. É reduzir atrito, tornar decisões explícitas e guiar o trabalho.</p></article>
          <article><span>03</span><h3>Engenharia</h3><p>Arquitetura, dados e interface são escolhidos para sustentar o processo — não para transformar a stack em protagonista.</p></article>
        </div>
      </div>
    </section>

    <section class="section shell about-preview">
      <div>
        <p class="overline">Sobre</p>
        <h2 data-cms="aboutTitle">{settings.aboutTitle}</h2>
      </div>
      <div>
        <p class="about-large" data-cms="aboutBody">{settings.aboutBody}</p>
        <a class="text-link" href="/sobre/">Mais sobre minha trajetória <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="contact-band">
      <div class="shell contact-grid">
        <p class="overline">Contato</p>
        <h2>Tem um processo público que pode funcionar melhor com software?</h2>
        <a class="button button-inverse" href={`mailto:${settings.email}`}>Conversar por e-mail</a>
      </div>
    </section>
  </main>
  <Footer />
  <LiveContent />
</BaseLayout>
