---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import LiveContent from "../components/LiveContent.astro";
import { getProjects, getSiteSettings } from "../lib/content";

const settings = await getSiteSettings();
const projects = await getProjects();
const featured = projects.find((project) => project.featured) || projects[0];
const others = projects.filter((project) => project._id !== featured?._id).slice(0, 3);
---
<BaseLayout>
  <Header active="inicio" />
  <main id="conteudo">
    <section class="hero shell">
      <div class="hero-copy">
        <p class="overline" data-cms="role">{settings.role}</p>
        <h1 data-cms="heroTitle">{settings.heroTitle}</h1>
        <p class="hero-lead" data-cms="heroBody">{settings.heroBody}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#projetos">Ver projetos</a>
          <a class="button button-quiet" href="/sobre/#andamento">Formação e em andamento <span aria-hidden="true">→</span></a>
        </div>
        <dl class="hero-facts">
          <div><dt>Base</dt><dd data-cms="location">{settings.location}</dd></div>
          <div><dt>Foco</dt><dd>Produtos de software próprios</dd></div>
          <div><dt>Abordagem</dt><dd>Validar o problema antes de construir</dd></div>
        </dl>
      </div>
      <div class="hero-system" aria-label="Etapas de um produto em desenvolvimento">
        <div class="system-label">PRODUTOS EM DESENVOLVIMENTO</div>
        <div class="system-flow">
          <div class="flow-node"><small>01</small><strong>Validar</strong><span>o problema existe?</span></div>
          <span class="flow-line"></span>
          <div class="flow-node"><small>02</small><strong>Construir</strong><span>decidir, revisar, testar</span></div>
          <span class="flow-line"></span>
          <div class="flow-node"><small>03</small><strong>Distribuir</strong><span>entregar a quem usa</span></div>
        </div>
        <div class="system-caption">O caminho que estou seguindo até a empresa.</div>
      </div>
    </section>

    <section class="section section-rule shell" id="projetos">
      <div class="section-intro split-heading">
        <div>
          <p class="overline">Projetos selecionados</p>
          <h2>O que estou construindo e o que aprendi em cada projeto.</h2>
        </div>
        <p>Cada projeto traz o problema, as decisões que tomei e o estado atual, inclusive quando foi arquivado.</p>
      </div>
      <div data-live-projects data-live-limit="4">
        {featured && <ProjectCard project={featured} featured />}
        {others.length > 0 && (
          <div class="project-list">
            {others.map((project) => <ProjectCard project={project} />)}
          </div>
        )}
      </div>
      <div class="section-action"><a class="text-link" href="/projetos/">Ver todos os projetos <span aria-hidden="true">→</span></a></div>
    </section>

    <section class="section approach-section">
      <div class="shell approach-grid">
        <div class="section-intro">
          <p class="overline">Como trabalho</p>
          <h2>Primeiro o problema. Depois o produto.</h2>
        </div>
        <div class="principles">
          <article><span>01</span><h3>Problema</h3><p>Antes de construir, defino qual problema o produto resolve e para quem. A Aresta foi arquivada por eu não ter feito isso.</p></article>
          <article><span>02</span><h3>Decisão</h3><p>Uso IA como apoio de desenvolvimento. Escopo, arquitetura e prioridades são decisões minhas, e reviso e testo o que é gerado.</p></article>
          <article><span>03</span><h3>Distribuição</h3><p>O objetivo é abrir uma empresa e distribuir software. Por isso cada projeto precisa de um estado claro: em desenvolvimento, arquivado ou concluído.</p></article>
        </div>
      </div>
    </section>

    <section class="section shell about-preview">
      <div>
        <p class="overline">Sobre</p>
        <h2 data-cms="aboutTitle">{settings.aboutTitle}</h2>
      </div>
      <div>
        <p class="about-large" data-cms="aboutBody">{settings.aboutBody}</p>
        <a class="text-link" href="/sobre/">Ler a página Sobre <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="contact-band">
      <div class="shell contact-grid">
        <p class="overline">Contato</p>
        <h2>Quer conversar sobre os projetos ou sobre produto?</h2>
        <a class="button button-inverse" href={`mailto:${settings.email}`}>Conversar por e-mail</a>
      </div>
    </section>
  </main>
  <Footer />
  <LiveContent />
</BaseLayout>
